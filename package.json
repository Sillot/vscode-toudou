{
  "name": "toudou",
  "displayName": "Toudou",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "quentin",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "l10n": "./l10n",
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Toudou",
      "properties": {
        "toudou.defaultStoragePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.defaultStoragePath.description%",
          "scope": "window"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "toudou",
          "title": "%viewsContainers.toudou.title%",
          "icon": "resources/logo.svg"
        }
      ]
    },
    "views": {
      "toudou": [
        {
          "id": "toudouView",
          "name": "%views.todos.name%"
        },
        {
          "id": "toudouHistoryView",
          "name": "%views.history.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "toudou.addTodo",
        "title": "%command.addTodo%",
        "category": "Toudou",
        "icon": "$(add)"
      },
      {
        "command": "toudou.completeTodo",
        "title": "%command.completeTodo%",
        "category": "Toudou"
      },
      {
        "command": "toudou.deleteTodo",
        "title": "%command.deleteTodo%",
        "category": "Toudou"
      },
      {
        "command": "toudou.addCategory",
        "title": "%command.addCategory%",
        "category": "Toudou",
        "icon": "$(new-folder)"
      },
      {
        "command": "toudou.renameCategory",
        "title": "%command.renameCategory%",
        "category": "Toudou"
      },
      {
        "command": "toudou.deleteCategory",
        "title": "%command.deleteCategory%",
        "category": "Toudou"
      },
      {
        "command": "toudou.restoreTodo",
        "title": "%command.restoreTodo%",
        "category": "Toudou"
      },
      {
        "command": "toudou.purgeHistory",
        "title": "%command.purgeHistory%",
        "category": "Toudou",
        "icon": "$(clear-all)"
      },
      {
        "command": "toudou.completeTodoInline",
        "title": "%command.completeTodoInline%",
        "icon": "$(check)"
      },
      {
        "command": "toudou.deleteTodoInline",
        "title": "%command.deleteTodoInline%",
        "icon": "$(trash)"
      },
      {
        "command": "toudou.editTodoTitle",
        "title": "%command.editTodoTitle%"
      },
      {
        "command": "toudou.editTodoDescription",
        "title": "%command.editTodoDescription%"
      },
      {
        "command": "toudou.changeTodoCategory",
        "title": "%command.changeTodoCategory%"
      },
      {
        "command": "toudou.renameCategoryInline",
        "title": "%command.renameCategoryInline%"
      },
      {
        "command": "toudou.deleteCategoryInline",
        "title": "%command.deleteCategoryInline%"
      },
      {
        "command": "toudou.copyTodoText",
        "title": "%command.copyTodoText%"
      },
      {
        "command": "toudou.changeCategoryEmoji",
        "title": "%command.changeCategoryEmoji%"
      },
      {
        "command": "toudou.addTodoToCategory",
        "title": "%command.addTodoToCategory%",
        "icon": "$(add)"
      },
      {
        "command": "toudou.restoreTodoInline",
        "title": "%command.restoreTodoInline%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "toudou.sortByManual",
        "title": "%command.sortByManual%"
      },
      {
        "command": "toudou.sortByPriority",
        "title": "%command.sortByPriority%"
      },
      {
        "command": "toudou.sortByCategory",
        "title": "%command.sortByCategory%"
      },
      {
        "command": "toudou.sortByCategoryPriority",
        "title": "%command.sortByCategoryPriority%"
      },
      {
        "command": "toudou.changeTodoPriority",
        "title": "%command.changeTodoPriority%",
        "category": "Toudou"
      },
      {
        "command": "toudou.changeTodoPriorityInline",
        "title": "%command.changeTodoPriorityInline%"
      },
      {
        "command": "toudou.openInCopilot",
        "title": "%command.openInCopilot%",
        "icon": "$(copilot)"
      },
      {
        "command": "toudou.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "toudou.openStorageFile",
        "title": "%command.openStorageFile%",
        "category": "Toudou"
      },
      {
        "command": "toudou.setWorkspacePath",
        "title": "%command.setWorkspacePath%",
        "category": "Toudou"
      }
    ],
    "submenus": [
      {
        "id": "toudou.sortMenu",
        "label": "%submenu.sortBy%",
        "icon": "$(list-ordered)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "toudou.addTodo",
          "when": "view == toudouView",
          "group": "navigation@1"
        },
        {
          "command": "toudou.addCategory",
          "when": "view == toudouView",
          "group": "navigation@2"
        },
        {
          "submenu": "toudou.sortMenu",
          "when": "view == toudouView",
          "group": "navigation@3"
        },
        {
          "command": "toudou.openSettings",
          "when": "view == toudouView",
          "group": "navigation@4"
        },
        {
          "command": "toudou.purgeHistory",
          "when": "view == toudouHistoryView",
          "group": "navigation"
        }
      ],
      "toudou.sortMenu": [
        {
          "command": "toudou.sortByManual",
          "group": "sort@1"
        },
        {
          "command": "toudou.sortByPriority",
          "group": "sort@2"
        },
        {
          "command": "toudou.sortByCategory",
          "group": "sort@3"
        },
        {
          "command": "toudou.sortByCategoryPriority",
          "group": "sort@4"
        }
      ],
      "view/item/context": [
        {
          "command": "toudou.deleteTodoInline",
          "when": "view == toudouView && viewItem == todo",
          "group": "inline@1"
        },
        {
          "command": "toudou.editTodoTitle",
          "when": "view == toudouView && viewItem == todo",
          "group": "1_edit@1"
        },
        {
          "command": "toudou.editTodoDescription",
          "when": "view == toudouView && viewItem == todo",
          "group": "1_edit@2"
        },
        {
          "command": "toudou.changeTodoCategory",
          "when": "view == toudouView && viewItem == todo",
          "group": "1_edit@3"
        },
        {
          "command": "toudou.changeTodoPriorityInline",
          "when": "view == toudouView && viewItem == todo",
          "group": "1_edit@4"
        },
        {
          "command": "toudou.openInCopilot",
          "when": "view == toudouView && viewItem == todo",
          "group": "3_copilot@1"
        },
        {
          "command": "toudou.copyTodoText",
          "when": "view == toudouView && viewItem == todo",
          "group": "2_copy@1"
        },
        {
          "command": "toudou.renameCategoryInline",
          "when": "view == toudouView && viewItem == category",
          "group": "1_category@1"
        },
        {
          "command": "toudou.deleteCategoryInline",
          "when": "view == toudouView && viewItem == category",
          "group": "1_category@2"
        },
        {
          "command": "toudou.changeCategoryEmoji",
          "when": "view == toudouView && viewItem == category",
          "group": "1_category@3"
        },
        {
          "command": "toudou.addTodoToCategory",
          "when": "view == toudouView && viewItem == category",
          "group": "inline@1"
        },
        {
          "command": "toudou.restoreTodoInline",
          "when": "view == toudouHistoryView && viewItem == completedTodo",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "toudou.completeTodoInline",
          "when": "false"
        },
        {
          "command": "toudou.deleteTodoInline",
          "when": "false"
        },
        {
          "command": "toudou.editTodoTitle",
          "when": "false"
        },
        {
          "command": "toudou.editTodoDescription",
          "when": "false"
        },
        {
          "command": "toudou.changeTodoCategory",
          "when": "false"
        },
        {
          "command": "toudou.renameCategoryInline",
          "when": "false"
        },
        {
          "command": "toudou.deleteCategoryInline",
          "when": "false"
        },
        {
          "command": "toudou.copyTodoText",
          "when": "false"
        },
        {
          "command": "toudou.changeCategoryEmoji",
          "when": "false"
        },
        {
          "command": "toudou.addTodoToCategory",
          "when": "false"
        },
        {
          "command": "toudou.restoreTodoInline",
          "when": "false"
        },
        {
          "command": "toudou.changeTodoPriorityInline",
          "when": "false"
        },
        {
          "command": "toudou.openInCopilot",
          "when": "false"
        },
        {
          "command": "toudou.sortByManual",
          "when": "false"
        },
        {
          "command": "toudou.sortByPriority",
          "when": "false"
        },
        {
          "command": "toudou.sortByCategory",
          "when": "false"
        },
        {
          "command": "toudou.sortByCategoryPriority",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "toudou.copyTodoText",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == toudouView"
      }
    ],
    "languageModelTools": [
      {
        "name": "toudou_createTodo",
        "displayName": "%tools.createTodo.displayName%",
        "description": "%tools.createTodo.description%",
        "modelDescription": "Create a new todo item in the user's workspace todo list. Optionally assign it to a category (created automatically if it doesn't exist) and add a description.",
        "parametersSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Title of the todo"
            },
            "category": {
              "type": "string",
              "description": "Category name (created if it doesn't exist, defaults to uncategorized)"
            },
            "description": {
              "type": "string",
              "description": "Optional description"
            }
          },
          "required": [
            "title"
          ]
        }
      },
      {
        "name": "toudou_listTodos",
        "displayName": "%tools.listTodos.displayName%",
        "description": "%tools.listTodos.description%",
        "modelDescription": "List all active (non-completed) todos in the user's workspace. Optionally filter by category name. Returns id, title, category and description for each todo.",
        "parametersSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Filter by category name"
            }
          }
        }
      },
      {
        "name": "toudou_completeTodo",
        "displayName": "%tools.completeTodo.displayName%",
        "description": "%tools.completeTodo.description%",
        "modelDescription": "Mark a todo as completed and move it to history. Provide either the todo id or its title (fuzzy matched).",
        "parametersSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID of the todo"
            },
            "title": {
              "type": "string",
              "description": "Title of the todo (fuzzy search)"
            }
          }
        }
      },
      {
        "name": "toudou_deleteTodo",
        "displayName": "%tools.deleteTodo.displayName%",
        "description": "%tools.deleteTodo.description%",
        "modelDescription": "Permanently delete a todo from the workspace. Provide either the todo id or its title (fuzzy matched). This action cannot be undone.",
        "parametersSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID of the todo"
            },
            "title": {
              "type": "string",
              "description": "Title of the todo (fuzzy search)"
            }
          }
        }
      },
      {
        "name": "toudou_createCategory",
        "displayName": "%tools.createCategory.displayName%",
        "description": "%tools.createCategory.description%",
        "modelDescription": "Create a new category to organize todos. Categories group todos in the sidebar tree view.",
        "parametersSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the category"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      {
        "name": "toudou_renameCategory",
        "displayName": "%tools.renameCategory.displayName%",
        "description": "%tools.renameCategory.description%",
        "modelDescription": "Rename an existing todo category. Provide the current name and the new name.",
        "parametersSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Current name of the category"
            },
            "newName": {
              "type": "string",
              "description": "New name for the category"
            }
          },
          "required": [
            "name",
            "newName"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepackage": "npm run check && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "package": "vsce package",
    "install-local": "npm run package && code --install-extension $(ls -t *.vsix | head -1)"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
